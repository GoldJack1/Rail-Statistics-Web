# api-dev.railstatistics.co.uk — staging query on :4002 (shared DATA_DIR, QUERY_READ_ONLY)

api-dev.railstatistics.co.uk {
	reverse_proxy 127.0.0.1:4002 {
		header_up Host {host}
		header_up X-API-Key {$INTERNAL_API_KEY}
		transport http {
			dial_timeout 2s
			response_header_timeout 8s
			read_timeout 20s
		}
	}
	# CORS comes from query-server only — duplicating Access-Control-Allow-Origin
	# here makes browsers reject the response (banner/health fetch fails).
}
