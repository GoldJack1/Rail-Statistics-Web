# Copy to .env on the VPS. Never commit secrets.

QUERY_PORT=4001
INGEST_PORT=4003
DATA_DIR=./data
TT_DIR=./tt
RETENTION_DAYS=30
INTERNAL_API_KEY=

# Darwin Push Port (RDM Kafka) — copy from legacy darwin .env
DARWIN_PUSH_BROKERS=
DARWIN_PUSH_TOPIC=
DARWIN_PUSH_USERNAME=
DARWIN_PUSH_PASSWORD=
DARWIN_PUSH_CONSUMER_GROUP=rail-core

# PTAC Kafka (all-day unit consist feed)
PTAC_ENABLED=1
PTAC_BROKERS=
PTAC_TOPIC=
PTAC_USERNAME=
PTAC_PASSWORD=
PTAC_GROUP_ID=rail-core-ptac

# 04:00 timetable (optional GCS prefix, e.g. gs://bucket/tt)
TT_GCS_URI=
GOOGLE_APPLICATION_CREDENTIALS=

# NRDP (HSP + timetable files)
NRDP_HSP_ORIGIN=https://hsp-prod.rockshore.net
NRDP_HSP_USER=
NRDP_HSP_PASSWORD=
NRDP_TT_ORIGIN=
SOURCE_HSP=nrdp
SOURCE_TIMETABLE=nrdp

# RDM (Push Port / KB if used)
RDM_CONSUMER_KEY=
RDM_CONSUMER_SECRET=

# Network Rail Open Data STOMP (RTPPM + TRUST)
NR_STOMP_HOST=publicdatafeeds.networkrail.co.uk
NR_STOMP_PORT=61618
NR_STOMP_SSL=0
NR_STOMP_USER=
NR_STOMP_PASSWORD=
NR_RTPPM_TOPIC=/topic/RTPPM_ALL
NR_TRUST_TOPIC=/topic/TRAIN_MVT_ALL_TOC

# TfL is polled from the website, not this process.
