# Local / later VPS. Never commit secrets.

QUERY_PORT=4001
INGEST_PORT=4003
DATA_DIR=./data
TT_DIR=./tt
RETENTION_DAYS=400
INTERNAL_API_KEY=

NRDP_HSP_ORIGIN=https://hsp-prod.rockshore.net
NRDP_HSP_USER=
NRDP_HSP_PASSWORD=

NR_STOMP_HOST=publicdatafeeds.networkrail.co.uk
NR_STOMP_PORT=61618
NR_STOMP_USER=
NR_STOMP_PASSWORD=
NR_TRUST_TOPIC=/topic/TRAIN_MVT_ALL_TOC


# Darwin Push Port (RDM Kafka) — copy from legacy darwin .env
DARWIN_PUSH_BROKERS=
DARWIN_PUSH_TOPIC=
DARWIN_PUSH_USERNAME=
DARWIN_PUSH_PASSWORD=
DARWIN_PUSH_CONSUMER_GROUP=rail-core

# PTAC Kafka (all-day unit consist feed)
PTAC_ENABLED=1
PTAC_BROKERS=
PTAC_TOPIC=
PTAC_USERNAME=
PTAC_PASSWORD=
PTAC_GROUP_ID=rail-core-ptac

# RDM NLC extract (TIPLOC names). Drop NLC*.xml.gz in tt/ or set NLC_PATH.
# NLC_PATH=./tt/NLC20260213.xml.gz

# 04:00 Europe/London GCS pull (old daemon window + 35m retry)
TT_FETCH_GRACE_MIN=35
TT_FETCH_RETRY_SEC=120
TT_GCS_BUCKET=gs://rail-statistics.firebasestorage.app
TT_GCS_PPT=gs://rail-statistics.firebasestorage.app/DARWINTTFILES/PPTimetable
TT_GCS_CORPUS=gs://rail-statistics.firebasestorage.app/DARWINCORPUS
TT_GCS_TOPS=gs://rail-statistics.firebasestorage.app/DARWINTOPS
TT_GCS_LONG=gs://rail-statistics.firebasestorage.app/DARWINLONGRANGETTFILES
GOOGLE_APPLICATION_CREDENTIALS=
INGEST_ORIGIN=http://127.0.0.1:4003
HSP_DETAILS_PER_SEC=5
HSP_CONCURRENCY=6
# Skip Darwin forecast-only RIDs (eta/etd, no actuals) — they 404 on HSP
HSP_SKIP_FORECAST_ONLY=1
# Set to 0 to skip importing the full CIF MCA after download
TT_IMPORT_CIF=1
# Calendar days after today to fill from the same CIF (0–28)
TT_CIF_AHEAD_DAYS=14

# Not used for live Darwin. Production is ../darwin with DARWIN_* + PTAC_*.
