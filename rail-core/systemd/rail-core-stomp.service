[Unit]
Description=rail-core NR STOMP TRUST + VSTP + TD
After=network.target rail-core-ingest.service

[Service]
Type=simple
WorkingDirectory=/home/darwin/rail-core
EnvironmentFile=/home/darwin/rail-core/.env
Environment=TZ=Europe/London
ExecStart=/usr/bin/node src/stomp-nr.js
Restart=always
RestartSec=5
User=darwin

[Install]
WantedBy=multi-user.target
