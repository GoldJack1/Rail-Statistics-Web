[Unit]
Description=rail-core ingest
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/darwin/rail-core
EnvironmentFile=/home/darwin/rail-core/.env
Environment=TZ=Europe/London
ExecStart=/usr/bin/node src/ingest-server.js
Restart=always
RestartSec=5
User=darwin

[Install]
WantedBy=multi-user.target
