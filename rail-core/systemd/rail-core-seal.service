[Unit]
Description=rail-core seal yesterday (HSP public actuals), after a successful timetable import
After=network.target rail-core-ingest.service

[Service]
Type=oneshot
TimeoutStartSec=6h
WorkingDirectory=/home/darwin/rail-core
EnvironmentFile=/home/darwin/rail-core/.env
Environment=TZ=Europe/London
ExecStart=/usr/bin/node src/seal-day.js
User=darwin
