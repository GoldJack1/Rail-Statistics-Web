[Unit]
Description=rail-core Darwin Kafka consumer
After=network.target rail-core-ingest.service

[Service]
Type=simple
WorkingDirectory=/home/darwin/rail-core
EnvironmentFile=/home/darwin/rail-core/.env
ExecStart=/usr/bin/node src/kafka-darwin.js
Restart=always
RestartSec=5
User=darwin

[Install]
WantedBy=multi-user.target
