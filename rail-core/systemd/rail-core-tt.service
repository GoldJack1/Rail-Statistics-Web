[Unit]
Description=rail-core 04:00 UK timetable + NLC + TOPS + CIF fetch
After=network.target
OnSuccess=rail-core-seal.service

[Service]
Type=oneshot
TimeoutStartSec=1h
WorkingDirectory=/home/darwin/rail-core
EnvironmentFile=/home/darwin/rail-core/.env
Environment=TZ=Europe/London
ExecStart=/usr/bin/node src/fetch-timetable.js
User=darwin
