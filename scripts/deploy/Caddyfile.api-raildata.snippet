# api-raildata.railstatistics.co.uk
# Live :4001 — live boards, ping/station/messages/window (Kafka on /api/ping)
# Heavy :4002 — units/unit/history/health/bash, plus dated departures/service
# Browser on railstatistics.co.uk talks here (not Netlify). Caddy injects X-API-Key.
# Set CORS_ORIGIN on the daemons to include https://railstatistics.co.uk
# Cloudflare can orange-cloud this hostname later (physical machine).
#
# Cloudflare Cache Rule (dashboard): Eligible for cache, 120s edge TTL,
# full query string in cache key. See scripts/deploy/cloudflare-hist-cache-rule.json

(darwin_cors) {
	@preflight {
		method OPTIONS
		header Origin https://railstatistics.co.uk https://www.railstatistics.co.uk
	}
	handle @preflight {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Accept"
		header Access-Control-Max-Age "86400"
		header Vary Origin
		respond 204
	}
}

# Include this on the site block so Safari can read Caddy 504s (otherwise fetch is "Load failed").
(darwin_error_cors) {
	handle_errors {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Accept"
		header Vary Origin
	}
}

(darwin_split) {
	@livePing path /api/ping
	handle @livePing {
		reverse_proxy 127.0.0.1:4001 {
			header_up X-API-Key {$INTERNAL_API_KEY}
		}
	}
	@heavy path /api/units* /api/unit/* /api/history* /api/health /api/plan/bash
	handle @heavy {
		reverse_proxy 127.0.0.1:4002 {
			header_up X-API-Key {$INTERNAL_API_KEY}
			transport http {
				dial_timeout 2s
				response_header_timeout 90s
				read_timeout 120s
			}
		}
	}
	@dated {
		path /api/departures/* /api/service/*
		query date=*
	}
	handle @dated {
		reverse_proxy 127.0.0.1:4002 {
			header_up X-API-Key {$INTERNAL_API_KEY}
			header_down Cache-Control "public, max-age=0, s-maxage=120, stale-while-revalidate=600"
			header_down CDN-Cache-Control "public, s-maxage=120, stale-while-revalidate=600"
			transport http {
				dial_timeout 2s
				response_header_timeout 90s
				read_timeout 120s
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:4001 {
			header_up X-API-Key {$INTERNAL_API_KEY}
		}
	}
}
