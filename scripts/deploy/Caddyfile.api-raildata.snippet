# Snippet for api-raildata.railstatistics.co.uk
# Live :4001 — live boards, timed today/future (date >= today), ping/station/messages/window
# Heavy :4002 — units/unit/history/health/bash
# Past-date boards: Caddy sends them to live, which proxies to :4002.

(darwin_split) {
	@heavy path /api/units* /api/unit/* /api/history* /api/health /api/plan/bash
	handle @heavy {
		reverse_proxy 127.0.0.1:4002
	}
	handle {
		reverse_proxy 127.0.0.1:4001
	}
}
