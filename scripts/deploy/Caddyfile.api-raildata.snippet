# api-raildata.railstatistics.co.uk
# rail-core query :4001 only. No darwin-heavy / :4002.

(darwin_cors) {
	@preflight {
		method OPTIONS
		header Origin https://railstatistics.co.uk https://www.railstatistics.co.uk
	}
	handle @preflight {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Accept"
		header Access-Control-Max-Age "86400"
		header Vary Origin
		respond 204
	}
}

(darwin_error_cors) {
	handle_errors {
		header Access-Control-Allow-Origin "{http.request.header.Origin}"
		header Access-Control-Allow-Methods "GET, POST, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Accept"
		header Vary Origin
	}
}

(darwin_split) {
	handle {
		reverse_proxy 127.0.0.1:4001 {
			header_up X-API-Key {$INTERNAL_API_KEY}
			transport http {
				dial_timeout 2s
				response_header_timeout 8s
				read_timeout 20s
			}
		}
	}
}
