rules_version = '2';

/**
 * Firestore security — named database `railstatisticstickets`
 * -----------------------------------------------------------
 * Same model as station collections on the default DB:
 * - Public read
 * - Writes only for station editors (`rs_station_editor` claim or master email)
 *
 * D-PAYG: `dpayg_schemes`, `dpayg_fares`
 *
 * Keep `defaultOwnerEmail()` in sync with
 * src/utils/masterPublishPolicy.ts DEFAULT_MASTER_PUBLISH_EMAIL
 * and the helpers in firestore.rules (default DB).
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    /** Must match masterPublishPolicy DEFAULT_MASTER_PUBLISH_EMAIL unless you rely on custom claims only. */
    function defaultOwnerEmail() {
      return 'wingatejack2021@gmail.com';
    }

    function isStationEditor() {
      return isSignedIn() && (
        request.auth.token.rs_station_editor == true ||
        (
          request.auth.token.email is string
          && request.auth.token.email.lower().trim() == defaultOwnerEmail().lower().trim()
        )
      );
    }

    // Same gate as stations_gbnr / other station collections.
    match /dpayg_schemes/{schemeId} {
      allow read: if true;
      allow create, update, delete: if isStationEditor();
    }

    match /dpayg_fares/{fareId} {
      allow read: if true;
      allow create, update, delete: if isStationEditor();
    }

    // Same catch-all as default firestore.rules: public read; no client writes.
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
