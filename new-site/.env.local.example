# Rail Statistics — Next.js environment variables
#
# Copy to .env.local and fill in. Never commit .env.local.
#
# Vite's `VITE_*` client-exposed prefix becomes Next.js's `NEXT_PUBLIC_*`.
# Server-only secrets get no prefix and must only be read inside Route Handlers
# (app/api/**/route.ts), never in Client Components.

# --- Firebase (client-safe — Phase 2) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- User accounts Firebase (rail-statistics-uas — consumer only; do not reuse catalogue keys) ---
NEXT_PUBLIC_UAS_FIREBASE_API_KEY=
NEXT_PUBLIC_UAS_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_UAS_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_UAS_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_UAS_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_UAS_FIREBASE_APP_ID=
NEXT_PUBLIC_UAS_FIREBASE_MEASUREMENT_ID=
# Optional separate App Check key for UAs (falls back to NEXT_PUBLIC_RECAPTCHA_SITE_KEY)
# NEXT_PUBLIC_UAS_RECAPTCHA_SITE_KEY=

# --- Dev / feature flags (client-safe) ---
NEXT_PUBLIC_SITE_URL=https://railstatistics.co.uk
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_USE_LOCAL_DATA_ONLY=false
NEXT_PUBLIC_LOCAL_DEV_LOGIN_BYPASS=false
NEXT_PUBLIC_USE_OSM_PROXY=
NEXT_PUBLIC_USE_STATION_CDN=true
# AdSense — must be exactly "true" to load script + render slots
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Consumer account + Stripe web billing — must be exactly "true" to show Account/Pricing
NEXT_PUBLIC_ACCOUNT_ENABLED=false
NEXT_PUBLIC_STATION_CDN_MANIFEST_URL=
# NEXT_PUBLIC_FIREBASE_APP_CHECK_DISABLED=false
# NEXT_PUBLIC_LOCAL_AUTH_EMAIL=
# NEXT_PUBLIC_LOCAL_AUTH_PASSWORD=
# NEXT_PUBLIC_MASTER_PUBLISH_EMAIL=wingatejack2021@gmail.com
# NEXT_PUBLIC_REQUIRE_REAUTH_FOR_SENSITIVE_ACTIONS=
# NEXT_PUBLIC_DARWIN_STARTUP_MAX_WAIT_MS=600000

# --- RevenueCat (web Stripe Billing + Account Settings status) ---
# Stripe/Web public key (strp_ / strp_sb_) — REQUIRED for POST /v1/receipts Stripe sync.
# NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
# Optional alias for the same Stripe public key (server-only).
# REVENUECAT_STRIPE_PUBLIC_API_KEY=
# Secret sk_ keys from the dashboard are API v2 only — they cannot call v1 /receipts (error 7723).
# Keep an appl_ key here if you want GET /v1/subscribers for App Store status (optional).
# REVENUECAT_API_KEY=
# Optional — creates Stripe Customer Portal sessions when RC management_url is missing.
# STRIPE_SECRET_KEY=
# Optional — Stripe Customer Portal configuration id (bpc_…). Sandbox example: bpc_1UD7cgDxpXAfNVfBLYV5gpwG
# STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
# Optional — Stripe publishable key (pk_test_… / pk_live_…). Not required for RC Web Checkout today.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# See docs/WEB_STRIPE_REVENUECAT.md for Stripe + RC dashboard setup.

# --- Darwin Netlify proxy (server-only — Phase 2) ---
# DARWIN_API_ORIGIN=https://api-darwin.railstatistics.co.uk
# DARWIN_API_KEY=
# DARWIN_UK_ONLY=true

# --- NRE Knowledgebase Stations XML (server-only — GBNR station detail tab) ---
# KB_STATIONS_API_ORIGIN=   # RDM Stations XML feed origin (set locally / in Netlify; do not commit the live URL)
# KB_STATIONS_API_KEY=          # RDM consumer key (sent as x-apikey)
# KB_STATIONS_CONSUMER_KEY=     # same as API key; optional alias
# KB_STATIONS_CONSUMER_SECRET=  # RDM consumer secret (stored for reference; not sent on XML GET)

# --- Darwin LDBWS (server-only) ---
# DARWIN_LDBWS_API_KEY=
# DARWIN_LDBWS_CONSUMER_KEY=
# DARWIN_LDBWS_CONSUMER_SECRET=
# DARWIN_SERVICE_DETAILS_API_KEY=
# DARWIN_SERVICE_DETAILS_CONSUMER_KEY=
# DARWIN_SERVICE_DETAILS_CONSUMER_SECRET=

# --- Darwin Push Port / Kafka (VM / darwin-local-test only — not Netlify web) ---
# DARWIN_PUSH_CONSUMER_GROUP=
# DARWIN_PUSH_USERNAME=
# DARWIN_PUSH_PASSWORD=
# DARWIN_PUSH_BROKERS=
# DARWIN_PUSH_TOPIC=
# DARWIN_KAFKA_*  (see Old Website darwin-local-test/.env.example)
