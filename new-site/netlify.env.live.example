# Same Netlify site → Production context (railstatistics.co.uk).
# Import secrets once (All scopes). Darwin origin + NEXT_PUBLIC_BETA_SITE for
# production are also set in netlify.toml [context.production.environment].
# Fill blanks from the live Netlify UI or a password manager. Do not commit real values.

# --- Firebase catalogue ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- User accounts Firebase ---
NEXT_PUBLIC_UAS_FIREBASE_API_KEY=
NEXT_PUBLIC_UAS_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_UAS_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_UAS_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_UAS_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_UAS_FIREBASE_APP_ID=
NEXT_PUBLIC_UAS_FIREBASE_MEASUREMENT_ID=

# --- Site flags ---
NEXT_PUBLIC_SITE_URL=https://railstatistics.co.uk
NEXT_PUBLIC_BETA_SITE=false
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_USE_LOCAL_DATA_ONLY=false
NEXT_PUBLIC_LOCAL_DEV_LOGIN_BYPASS=false
NEXT_PUBLIC_USE_OSM_PROXY=true
NEXT_PUBLIC_USE_STATION_CDN=true
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ACCOUNT_ENABLED=false

# --- Darwin (public query) ---
DARWIN_API_ORIGIN=https://api-raildata.railstatistics.co.uk
NEXT_PUBLIC_DARWIN_BROWSER_ORIGIN=https://api-raildata.railstatistics.co.uk
DARWIN_API_KEY=
DARWIN_UK_ONLY=true

# --- Knowledgebase / TfL ---
KB_STATIONS_API_ORIGIN=
KB_STATIONS_API_KEY=
KB_STATIONS_CONSUMER_KEY=
KB_STATIONS_CONSUMER_SECRET=
KB_INCIDENTS_API_ORIGIN=
TFL_APP_KEY=

# --- RevenueCat / Stripe (if NEXT_PUBLIC_ACCOUNT_ENABLED=true) ---
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
REVENUECAT_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
