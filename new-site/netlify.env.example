# Variables to import into Netlify (Site configuration → Environment variables).
# Copy values from .env.local — do NOT commit real values here.
#
# Phase 2 web app only. Darwin PUSH/KAFKA/LINX/LDBWS keys in .env.local are for the
# Darwin VM, not this Next.js site. If you keep them in Netlify anyway, netlify.toml
# omits them from secrets scanning.

# --- Firebase (client — Phase 2) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Feature flags ---
NEXT_PUBLIC_SITE_URL=https://railstatistics.co.uk
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_USE_LOCAL_DATA_ONLY=false
NEXT_PUBLIC_LOCAL_DEV_LOGIN_BYPASS=false
NEXT_PUBLIC_USE_OSM_PROXY=true
NEXT_PUBLIC_USE_STATION_CDN=true
# Optional override — defaults to Firebase Storage manifest URL derived from bucket
NEXT_PUBLIC_STATION_CDN_MANIFEST_URL=
# AdSense — must be exactly "true" to load script + render slots (off by default)
NEXT_PUBLIC_ADSENSE_ENABLED=false

# --- RevenueCat / Stripe web billing ---
# Stripe/Web public key (strp_ / strp_sb_) — required for Stripe purchase sync (API v1)
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
# Optional: Apple/public key for GET subscribers only — do NOT use a v2 sk_ here for /receipts
REVENUECAT_API_KEY=
# Optional: store v2 secret separately if you add API v2 later (not used for v1 Stripe sync)
# REVENUECAT_V2_SECRET_API_KEY=
# Optional — Stripe Customer Portal sessions when RC has no static manage URL
STRIPE_SECRET_KEY=
# Stripe Customer Portal configuration id (bpc_…) — sandbox: bpc_1UD7cgDxpXAfNVfBLYV5gpwG
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# --- Darwin web proxy (server — Phase 2 route handler) ---
DARWIN_API_ORIGIN=https://api-darwin.railstatistics.co.uk
DARWIN_API_KEY=

# --- NRE Knowledgebase Stations XML (server — GBNR Knowledgebase tab) ---
# Set the RDM Stations XML feed origin in the Netlify UI (do not commit the live URL).
KB_STATIONS_API_ORIGIN=
KB_STATIONS_API_KEY=
KB_STATIONS_CONSUMER_KEY=
KB_STATIONS_CONSUMER_SECRET=
